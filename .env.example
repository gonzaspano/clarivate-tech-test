PORT=3000
RANDOMUSER_BASE_URL=https://randomuser.me/api
RANDOMUSER_TIMEOUT_MS=10000
LLM_TIMEOUT_MS=60000

# LLM provider: "ollama" (default, local, no key) or "gemini" (needs GEMINI_API_KEY)
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_MAX_TOKENS=256

# Gemini (Google AI Studio). Put your real key in .env, never in this file.
GEMINI_API_KEY=abc
GEMINI_MODEL=gemini-3.8-flash
